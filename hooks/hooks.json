{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-gates.pl\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-gates.pl\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
